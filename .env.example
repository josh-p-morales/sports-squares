# ==============================================================================
# Sports Squares: College Basketball (ESPN -> Google Sheets)
# ==============================================================================

# Data Source: "espn" (default, free, no API key required)
DATA_SOURCE=espn
ESPN_LEAGUE=mens       # "mens" (NCAA Men's Basketball) or "womens" (NCAA Women's Basketball)

# Google Sheets Configuration
# ------------------------------------------------------------------------------
# OPTION A (Recommended - ZERO Google Cloud setup):
# 1. Open your Google Spreadsheet: https://docs.google.com/spreadsheets/d/.../edit
# 2. Go to Extensions > Apps Script, paste google_apps_script.js, Deploy as Web App ("Execute as: Me", "Who has access: Anyone").
# 3. Paste the generated Web App URL below:
GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# OPTION B (Google Cloud Service Account - only if not using Option A):
# GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json
# GOOGLE_SPREADSHEET_ID=

# Optional Sheet tab names (defaults are "Games Log" and "Squares Tracker")
SHEET_GAMES_LOG_NAME=Games Log
SHEET_SQUARES_TRACKER_NAME=Squares Tracker

# Polling Interval (in seconds) when running in live poll mode
POLL_INTERVAL_SECONDS=60
